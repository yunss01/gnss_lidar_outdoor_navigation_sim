<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>launch_pkg</name>
  <version>0.0.0</version>
  <description>Launch files for GNSS and 3D LiDAR outdoor navigation</description>
  <maintainer email="dudrhkd7811@naver.com">glory</maintainer>
